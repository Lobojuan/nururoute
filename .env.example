# NuruNode — environment placeholders. NONE of these are real credentials.
# Copy to .env and keep mock values for local development.

NODE_ENV=development

# ---- API (apps/api) ----
API_PORT=4000
DATABASE_URL=postgres://nurunode:nurunode@localhost:5432/nurunode
SESSION_SECRET=dev-only-session-secret-change-me-32-chars-min
ALLOW_DEV_LOGIN=true
WEB_ORIGIN=http://localhost:3000

# Adapters. PAYMENT_ADAPTER: "mock" (default) or "momo_sandbox" (feature flag, MTN test env).
# PROVIDER_ADAPTER: only "mock" is supported.
PAYMENT_ADAPTER=mock
PROVIDER_ADAPTER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret-not-real

# Google sign-in scaffold (leave empty -> Google button returns 501)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upstream provider placeholders — MUST stay fake in this repository
OPENAI_API_KEY=mock-not-a-real-key
ANTHROPIC_API_KEY=mock-not-a-real-key
# Reserved for a future server-side Groq adapter. Keep PROVIDER_ADAPTER=mock
# until written provider approval and a separate implementation review exist.
GROQ_API_KEY=mock-not-a-real-key

# MTN MoMo SANDBOX (only read when PAYMENT_ADAPTER=momo_sandbox). Sandbox credentials are
# free test credentials from https://momodeveloper.mtn.com — still never commit real ones.
# Get them with: MTN_MOMO_SUBSCRIPTION_KEY=<key> bun run momo:provision
MTN_MOMO_SUBSCRIPTION_KEY=mock-not-a-real-key
MTN_MOMO_API_USER=mock
MTN_MOMO_API_KEY=mock
MTN_MOMO_TARGET_ENV=sandbox          # the API refuses anything else
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_CURRENCY=EUR                # MTN sandbox only accepts EUR
MTN_MOMO_CALLBACK_URL=               # optional, e.g. https://<tunnel>/webhooks/payments/momo

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
